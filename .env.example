# Copy this file to .env at the repository root. No credentials are needed for UI previews.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3001
NEXT_PUBLIC_STORE_URL=http://localhost:3002
BACKEND_PORT=3003
# For local production-build previews only; every app URL must be HTTP loopback.
VOID_LOCAL_PREVIEW=false

# Supply a PostgreSQL database, then run npm run db:deploy.
DATABASE_URL=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Production only: voidclient.org (only when all sibling subdomains are trusted).
AUTH_COOKIE_DOMAIN=
# Your reverse proxy MUST overwrite this header. See docs/security.md.
AUTH_IP_HEADER=x-real-ip

# Authentication email is queued in PostgreSQL and sent by the backend worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional Discord OAuth. Register the account app callback in Discord's portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Microsoft sign-in uses the existing Better Auth server and email verification.
# Register a Web callback: http://localhost:3001/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Personal Microsoft accounts (appropriate for Minecraft); common also allows work/school.
MICROSOFT_TENANT_ID=consumers

# Stripe-hosted Checkout. Publish genuine products with Stripe Price IDs first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STORE_CHECKOUT_ENABLED=false
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Public content. Leave unknown values empty.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.com/invite/fRs86qQXCT
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_LINUX=
NEXT_PUBLIC_DOWNLOAD_MACOS=
NEXT_PUBLIC_DOWNLOAD_ANDROID=
NEXT_PUBLIC_DOWNLOAD_IOS=
NEXT_PUBLIC_CLIENT_VERSION=
NEXT_PUBLIC_CLIENT_RELEASE_DATE=
# Only approved, published legal pages. No placeholder links are rendered.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_REFUND_URL=

# A separate DISPOSABLE database is required by integration tests.
TEST_DATABASE_URL=
