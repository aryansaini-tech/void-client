{
  "name": "@void/store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "prebuild": "prisma generate --schema ../../backend/prisma/schema.prisma",
    "build": "next build",
    "start": "node ../../scripts/start-app.mjs store",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@void/ui": "*",
    "@void/shared": "*",
    "@void/design-system": "*",
    "@void/config": "*",
    "@fontsource-variable/manrope": "^5.2.8",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.468.0",
    "@void/backend": "*",
    "better-auth": "1.7.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21"
  },
  "exports": {
    "./app/api/*": "./src/app/api/*.ts",
    "./app/sitemap": "./src/app/sitemap.ts",
    "./app/*": "./src/app/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  }
}
